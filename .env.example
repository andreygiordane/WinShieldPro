# ==============================================================================
# WinShield Pro Enterprise - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env caso deseje personalizar configurações locais.
# ==============================================================================

# Porta do Servidor Desktop REST API (Padrão: 60321)
WINSHIELD_PORT=60321

# Ambiente de Execução (development | production)
WINSHIELD_ENV=development

# Configurações Opcionais para Assinatura de Código (Code Signing)
# IMPORTANTE: Nunca commite sua senha real no controle de versão!
CODE_SIGN_SUBJECT="CN=WinShield Pro Developer, O=WinShield Pro, OU=Software Development"
CODE_SIGN_PASSWORD="DefinaSuaSenhaForteAqui"
